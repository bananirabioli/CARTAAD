# Copia a .env solo si quieres cambiar algo: sin este archivo todo corre en modo mock.

# --- IA ---
# LLM_PROVIDER=mock            # mock (por defecto, sin llaves) | anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5  # obligatorio si LLM_PROVIDER=anthropic; no se fija en código

# --- Imágenes ---
# IMAGE_PROVIDER=placeholder   # placeholder (por defecto) | external
# EXTERNAL_IMAGE_ENABLED=false
# EXTERNAL_IMAGE_URL=
# EXTERNAL_IMAGE_API_KEY=

# --- Almacenamiento ---
# STORAGE_BACKEND=local        # local | s3 (con `docker compose --profile s3 up`)
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET=cartaad
# S3_ACCESS_KEY=cartaad
# S3_SECRET_KEY=cartaad-secret

# --- Sesión ---
# SECRET_KEY=cambia-esto-en-produccion
# DEMO_MODE=true
