# Copia a .env y ajusta. Por defecto corre el MVP con OpenRouter; para la demo offline usa DEMO_MODE=true,
# LLM_PROVIDER=mock, IMAGE_PROVIDER=placeholder y VIDEO_PROVIDER=none.

# --- Usuario maestro (se crea al primer arranque con la base vacía; DEMO_MODE=false) ---
ADMIN_EMAIL=admin@ejemplo.mx
ADMIN_PASSWORD=cambia-esto
# ADMIN_NAME=Administrador
# INITIAL_CLIENT_NAME=Candidatura Juárez
# INITIAL_CLIENT_CONTEXT=Juárez, Chihuahua

# --- IA: OpenRouter (texto, visión, imagen y video con una sola llave) ---
OPENROUTER_API_KEY=
# LLM_PROVIDER=openrouter        # openrouter | anthropic | mock
# IMAGE_PROVIDER=openrouter      # openrouter | placeholder | external
# VIDEO_PROVIDER=openrouter      # openrouter | none (solo prompt y guion)
# OPENROUTER_MODEL_ANALYSIS=anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL_TEXT=anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL_IMAGE=google/gemini-3.1-flash-image
# OPENROUTER_MODEL_VIDEO=google/veo-3.1-lite
# OPENROUTER_VIDEO_RESOLUTION=720p
# VIDEO_MAX_SECONDS=6

# --- Almacenamiento ---
# STORAGE_BACKEND=local          # local | s3 (con `docker compose --profile s3 up`)
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET=cartaad
# S3_ACCESS_KEY=cartaad
# S3_SECRET_KEY=cartaad-secret

# --- Sesión y despliegue ---
# SECRET_KEY=cambia-esto-en-produccion
# DOMAIN=cartaad.ejemplo.mx
# DEMO_MODE=false
