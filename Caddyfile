# HTTPS is automatic. DOMAIN needs an A/AAAA record pointing at this server and ports 80/443 open.
{$DOMAIN} {
	encode zstd gzip

	# Every seeded account shares the public demo password, so the whole site sits behind one shared login.
	# Remove this block only after replacing the seeded passwords.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy web:3000
}
