# HTTPS is automatic. DOMAIN needs an A/AAAA record pointing at this server and ports 80/443 open.
# Access is the app's own login (one master user from ADMIN_EMAIL / ADMIN_PASSWORD); there are no shared demo passwords.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy web:3000
}
